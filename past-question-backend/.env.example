# ---------------------------------------------------------------------------
# Environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in real values for your environment:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed. Never put real secrets,
# passwords, API keys, or production connection strings in THIS example file.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | preview | production
NODE_ENV=development

# HTTP port the server listens on.
PORT=3000

# PostgreSQL connection string consumed by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/past_questions?schema=public"

# API routing -> /api/v1
API_PREFIX=api
API_VERSION=1

# CORS: comma-separated list of allowed origins, or `*` for all (dev only).
# Set explicit origins in preview/production — never leave `*` in production.
CORS_ORIGINS=*

# Rate limiting (in-memory foundation guard).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120


# Document storage/security
STORAGE_LOCAL_DIR=./private-storage
# Maximum accepted plaintext PDF size (25 MiB default)
DOCUMENT_MAX_SIZE_BYTES=26214400
# Base64/hex/string secret used as the document envelope-encryption master key.
# Set a dedicated high-entropy secret in preview/production; do not reuse JWT keys.
CONTENT_ENCRYPTION_KEY=
CONTENT_AUTHORIZATION_TTL_MS=300000
CONTENT_DOWNLOAD_RATE_LIMIT=30
CONTENT_DOWNLOAD_RATE_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Production-hardening settings (see docs/deployment.md)
# ---------------------------------------------------------------------------
# Document data-key wrapping. Production must use aws-kms.
# 'env' uses DOCUMENT_MASTER_KEYS and is for development only.
DOCUMENT_KEY_PROVIDER=env
KMS_KEY_ID=
KMS_REGION=
KMS_ENDPOINT=
KMS_ACCESS_KEY_ID=
KMS_SECRET_ACCESS_KEY=
# Development only: "<version>:<base64 32-byte key>"
DOCUMENT_MASTER_KEYS=
DOCUMENT_MASTER_KEY_VERSION=1

# Transactional email (Resend). Required in production.
RESEND_API_KEY=
EMAIL_FROM=

# Object storage. Production must use s3 with an https endpoint.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./private-storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Rate limiting. Production must use postgres (shared across instances).
THROTTLE_STORE=memory

# Reverse proxy trust: false, a hop count (e.g. 1), or 'loopback'. Required in production.
TRUST_PROXY=false
